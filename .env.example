# Copiar a .env y ajustar: cp .env.example .env
# .env está en .gitignore; no subir credenciales reales.
# Todas estas variables tienen el mismo valor por defecto en compose.yaml,
# así que el stack arranca aunque no exista .env.

# --- Base de datos (servicio "db", postgres:16) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=boletos_db
# Puerto publicado en el host
POSTGRES_PORT=5432

# --- Aplicación (servicio "app") ---
APP_PORT=3000
FRONTEND_URL=http://localhost:5173

# --- Pruebas de integración desde el host (npm test en lumiereApp/backend) ---
# Activa la suite del adaptador PostgreSQL contra la base del compose
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/boletos_db
